# =============================================================================
# manefo .gitignore
# =============================================================================

# 環境変数（絶対にコミットしない）
.env
.env.local
.env.*.local
.env.production
.env.development

# Node
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.turbo/
*.tsbuildinfo

# Rust
target/
backend/**/*.pdb

# Supabase
supabase/.branches/
supabase/.temp/

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# テスト
coverage/
.nyc_output/

# Docker
*.env.docker
